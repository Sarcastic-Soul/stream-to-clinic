{
  "name": "stream-to-clinic-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/fhir": "^0.0.44",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
